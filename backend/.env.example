APP_NAME=gps-cloud-backend
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=gps_tracker

DEVICE_OFFLINE_SECONDS=300

# MQTT (EMQX/Mosquitto) - leave MQTT_HOST empty to disable
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=gps/upload
MQTT_HEALTH_TOPIC=health/upload
MQTT_COMMAND_TOPIC_TEMPLATE=gps/device/{device_id}/command
# 统一总线topic：新固件只需硬编码这一个topic字符串，无需拼接device_id。
# 上行/下行都走这里，靠payload里的 dir(up/down)+type+id 字段区分。
# 旧的三个topic仍然保留兼容，两套协议同时生效。
MQTT_BUS_TOPIC=device/all
MQTT_CLIENT_ID=gps-backend
MQTT_KEEPALIVE=60
MQTT_QOS=1
